# Server Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/mern_dev_db

# Environment mode
NODE_ENV=development

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# LLM Provider: 'gemini' (default) or 'mock' (for deterministic tests)
LLM_PROVIDER=gemini

# Frontend Client URL for CORS allowlist
CLIENT_URL=http://localhost:5173

# GitHub Personal Access Token (Optional)
# Users provide their PAT in the UI when publishing documentation via pull requests.
# Tokens are used strictly transiently and are NEVER saved to the database.
