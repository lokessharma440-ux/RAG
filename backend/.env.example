# ====================================================================
# DevMind AI Backend — Environment Configuration Template
# ====================================================================

# Server Port (Render automatically sets PORT dynamically in production)
PORT=5000

# Environment Mode ('development' | 'production')
NODE_ENV=development

# MongoDB Connection URI
# Local Development: mongodb://127.0.0.1:27017/mern_dev_db
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/devmind?retryWrites=true&w=majority
# IMPORTANT: In MongoDB Atlas Network Access, whitelist 0.0.0.0/0 (or Render outbound IPs)
MONGO_URI=mongodb://127.0.0.1:27017/mern_dev_db

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-2.5-flash-lite, fallback to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# JWT Secret for Session Authentication (Must be a long random cryptographic secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_generate_with_openssl_rand_base64_32

# LLM Provider: 'gemini' (default for production/live) or 'mock' (for deterministic offline test suites)
LLM_PROVIDER=gemini

# Frontend Client URL(s) for CORS allowlist
# For single origin: https://your-project.vercel.app
# For multiple comma-separated origins: https://your-project.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Optional: Allow Vercel preview deployment URLs (*.vercel.app) through CORS
ALLOW_VERCEL_PREVIEWS=true

# Optional: Run live Gemini security tests during security test suite
RUN_LIVE_GEMINI_ATTACKS=false

# GitHub Personal Access Token (Optional)
# Users provide their PAT in the UI when publishing documentation via pull requests.
# Tokens are used strictly transiently and are NEVER saved to the database.
